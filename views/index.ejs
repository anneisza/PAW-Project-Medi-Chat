
<%- include('partials/head', { judul: judul }) %>

<body class="bg-kabut text-tinta font-sans">

<header class="bg-white shadow-sm border-b border-mint">
    <div class="max-w-6xl mx-auto px-6 py-5 flex justify-between items-center">
        <h1 class="text-2xl font-bold text-medis">
            ✚ MediChat
        </h1>

        <nav class="flex gap-5 text-sm">
            <a href="#layanan">Data Layanan</a>
            <a href="/api/status">API Status</a>
        </nav>
    </div>
</header>

<main class="max-w-6xl mx-auto px-6">

<section class="text-center py-14">
    <h2 class="text-4xl font-bold text-medis">
        Manajemen Layanan Kesehatan
    </h2>

    <p class="mt-4 text-abu">
        Kelola data layanan kesehatan Puskesmas melalui MediChat.
    </p>

    <p id="status" class="mt-5 text-sm">
        Memeriksa koneksi server...
    </p>
</section>

<section id="layanan" class="pb-16">

    <div class="flex justify-between items-center mb-6 gap-3">
        <h3 class="text-2xl font-bold text-medis">
            Daftar Layanan
        </h3>

        <button onclick="tambahProduk()"
            class="bg-medis text-white px-5 py-3 rounded-lg">
            + Tambah Layanan
        </button>
    </div>

    <p id="pesan" class="mb-4 text-sm"></p>

    <div class="bg-white rounded-xl shadow-sm overflow-x-auto">
        <table class="w-full text-sm text-left">

            <thead class="bg-mint text-medis">
                <tr>
                    <th class="p-4">ID</th>
                    <th class="p-4">Nama</th>
                    <th class="p-4">Kategori</th>
                    <th class="p-4">Harga</th>
                    <th class="p-4">Jadwal</th>
                    <th class="p-4">Jam</th>
                    <th class="p-4">Aksi</th>
                </tr>
            </thead>

            <tbody id="tabel-produk">
                <tr>
                    <td colspan="7" class="p-5 text-center">
                        Memuat data...
                    </td>
                </tr>
            </tbody>

        </table>
    </div>
</section>

</main>

<!-- MODAL FORM -->
<div id="modal"
    class="hidden fixed inset-0 bg-black/50 z-50 p-4 overflow-y-auto">

    <div class="bg-white max-w-lg mx-auto mt-10 rounded-xl p-6">

        <h3 id="judul-modal"
            class="text-xl font-bold text-medis mb-5">
            Tambah Layanan
        </h3>

        <form id="form-produk" class="space-y-4">

            <input type="hidden" id="id">

            <input id="nama"
                placeholder="Nama layanan"
                required maxlength="150"
                class="w-full border p-3 rounded-lg">

            <input id="kategori"
                placeholder="Kategori"
                required maxlength="100"
                class="w-full border p-3 rounded-lg">

            <input id="harga"
                type="number"
                min="0"
                placeholder="Harga"
                required
                class="w-full border p-3 rounded-lg">

            <input id="jadwal"
                placeholder="Jadwal"
                required maxlength="150"
                class="w-full border p-3 rounded-lg">

            <input id="jam"
                placeholder="Jam layanan"
                required maxlength="100"
                class="w-full border p-3 rounded-lg">

            <div class="flex justify-end gap-3">

                <button type="button"
                    onclick="tutupModal()"
                    class="border px-4 py-2 rounded-lg">
                    Batal
                </button>

                <button type="submit"
                    class="bg-medis text-white px-4 py-2 rounded-lg">
                    Simpan
                </button>

            </div>
        </form>
    </div>
</div>

<script>
const API = '/api/produk';

const tbody = document.getElementById('tabel-produk');
const modal = document.getElementById('modal');
const form = document.getElementById('form-produk');

function rupiah(harga) {
    return new Intl.NumberFormat('id-ID', {
        style: 'currency',
        currency: 'IDR',
        maximumFractionDigits: 0
    }).format(Number(harga));
}

function tampilPesan(teks, berhasil = true) {
    const el = document.getElementById('pesan');
    el.textContent = teks;
    el.className = berhasil
        ? 'mb-4 text-sm text-green-700'
        : 'mb-4 text-sm text-red-600';
}

async function request(url, options = {}) {
    const response = await fetch(url, {
        ...options,
        headers: {
            'Content-Type': 'application/json',
            ...options.headers
        }
    });

    const result = await response.json();

    if (!response.ok) {
        throw new Error(
            result.errors
                ? result.errors.join(', ')
                : result.pesan
        );
    }

    return result;
}

// READ: menampilkan data
async function tampilProduk() {
    try {
        const result = await request(API);

        tbody.innerHTML = '';

        if (result.data.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="7" class="p-5 text-center">
                        Belum ada data layanan.
                    </td>
                </tr>`;
            return;
        }

        result.data.forEach(p => {
            const tr = document.createElement('tr');
            tr.className = 'border-t hover:bg-kabut';

            [p.id, p.nama, p.kategori, rupiah(p.harga),
             p.jadwal, p.jam].forEach(value => {
                const td = document.createElement('td');
                td.className = 'p-4';
                td.textContent = value;
                tr.appendChild(td);
            });

            const aksi = document.createElement('td');
            aksi.className = 'p-4 whitespace-nowrap';

            const edit = document.createElement('button');
            edit.textContent = 'Edit';
            edit.className = 'text-blue-700 mr-3 font-semibold';
            edit.onclick = () => editProduk(p.id);

            const hapus = document.createElement('button');
            hapus.textContent = 'Hapus';
            hapus.className = 'text-red-600 font-semibold';
            hapus.onclick = () => hapusProduk(p.id, p.nama);

            aksi.append(edit, hapus);
            tr.appendChild(aksi);

            tbody.appendChild(tr);
        });

    } catch (error) {
        tampilPesan(error.message, false);
    }
}

// CREATE: membuka form
function tambahProduk() {
    form.reset();
    document.getElementById('id').value = '';
    document.getElementById('judul-modal').textContent =
        'Tambah Layanan';
    modal.classList.remove('hidden');
}

// Menutup modal
function tutupModal() {
    modal.classList.add('hidden');
    form.reset();
}

// CREATE dan UPDATE
form.addEventListener('submit', async function(e) {
    e.preventDefault();

    const id = document.getElementById('id').value;

    const data = {
        nama: document.getElementById('nama').value.trim(),
        kategori: document.getElementById('kategori').value.trim(),
        harga: Number(document.getElementById('harga').value),
        jadwal: document.getElementById('jadwal').value.trim(),
        jam: document.getElementById('jam').value.trim()
    };

    try {
        const result = await request(
            id ? `${API}/${id}` : API,
            {
                method: id ? 'PUT' : 'POST',
                body: JSON.stringify(data)
            }
        );

        tutupModal();
        await tampilProduk();
        tampilPesan(result.pesan);

    } catch (error) {
        tampilPesan(error.message, false);
    }
});

// UPDATE: mengambil detail produk
async function editProduk(id) {
    try {
        const result = await request(`${API}/${id}`);
        const p = result.data;

        document.getElementById('id').value = p.id;
        document.getElementById('nama').value = p.nama;
        document.getElementById('kategori').value = p.kategori;
        document.getElementById('harga').value = p.harga;
        document.getElementById('jadwal').value = p.jadwal;
        document.getElementById('jam').value = p.jam;

        document.getElementById('judul-modal').textContent =
            'Edit Layanan';

        modal.classList.remove('hidden');

    } catch (error) {
        tampilPesan(error.message, false);
    }
}

// DELETE
async function hapusProduk(id, nama) {
    if (!confirm(`Hapus layanan ${nama}?`)) return;

    try {
        const result = await request(`${API}/${id}`, {
            method: 'DELETE'
        });

        await tampilProduk();
        tampilPesan(result.pesan);

    } catch (error) {
        tampilPesan(error.message, false);
    }
}

// Status API
async function cekStatus() {
    try {
        await request('/api/status');
        document.getElementById('status').textContent =
            '● Server dan API aktif';
        document.getElementById('status').className =
            'mt-5 text-sm text-green-700';
    } catch {
        document.getElementById('status').textContent =
            '● Server tidak terhubung';
    }
}

cekStatus();
tampilProduk();
</script>

<%- include('partials/footer') %>
