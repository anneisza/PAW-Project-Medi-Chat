<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof judul !== 'undefined' ? judul : 'Medi-Chat' %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body<%- typeof bodyClass !== 'undefined' ? ` class="${bodyClass}"` : '' %>>
    <header>
        <nav class="navbar">
            <a href="/" class="logo-container">
                <img class="logo" src="/assets/logo.png" alt="Medi-Chat Logo">
                <div class="logo-text">
                    <h4>Puskesmas</h4>
                    <p>Sehat pilihan kita</p>
                </div>
            </a>
            <input type="checkbox" id="menu-toggle" class="menu-toggle">
            <label for="menu-toggle" class="hamburger" aria-label="Buka menu">
                <span></span>
                <span></span>
                <span></span>
            </label>
            <ul class="nav-links">
                <li class="home"><a href="/">Home</a></li>
                <li class="informasi">
                    <a>Informasi</a>
                    <ul class="dropdown-info">
                        <li><a href="/informasi#pendaftaran">Pendaftaran</a></li>
                        <li><a href="/informasi#jadwal">Jadwal Layanan</a></li>
                        <li><a href="/informasi#biaya">Biaya Rawat</a></li>
                    </ul>
                </li>
                <li class="mindichat"><a href="/medichat">Medi-Chat</a></li>
                <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                    <li class="tentang"><a href="/admin">Dashboard</a></li>
                <% } else { %>
                    <li class="tentang"><a href="/admin/login">Login</a></li>
                <% } %>
            </ul>
        </nav>
    </header>